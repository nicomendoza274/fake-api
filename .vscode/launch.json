{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Fake-API DEV",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "envFile": "${workspaceFolder}/.env.dev",
            "args": [
                "src.main:app",
                "--reload"
            ],
            "jinja": true,
        },
        {
            "name": "Fake-API QA",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "envFile": "${workspaceFolder}/.env.qa",
            "args": [
                "src.main:app",
                "--reload"
            ],
            "jinja": true,
        }
    ]
}